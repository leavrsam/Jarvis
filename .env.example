# Login (checked on the server; never prefix with VITE_)
# JARVIS_LOGIN_PASSWORD: the passcode you type on the login screen
# JARVIS_SESSION_SECRET: random, at least 32 characters (e.g. `openssl rand -base64 32`)
JARVIS_LOGIN_PASSWORD=
JARVIS_SESSION_SECRET=

# Google AI Studio API Key for Gemini 3.8 Expressive TTS & Custom Voice Design
GEMINI_API_KEY=your_gemini_api_key_here

# n8n webhook, called only by the server proxy (/api/jarvis-command), which adds the
# X-Jarvis-Key header. Server-side only: never prefix these with VITE_ (VITE_ vars are public).
JARVIS_WEBHOOK_URL=
JARVIS_WEBHOOK_SECRET=
# n8n media webhook for SHOW_CAMERA (called only by /api/camera, with the same X-Jarvis-Key secret)
JARVIS_MEDIA_URL=
# n8n calendar webhook for the HUD's calendar card (called only by /api/calendar, same secret)
JARVIS_CALENDAR_URL=
# Optional: extra origins allowed to call the proxy, comma-separated (same-origin is always allowed)
JARVIS_ALLOWED_ORIGINS=

# Voice Comparison Lab (/#/voice-compare): server-side only, never prefix with VITE_
# Any provider left blank shows as "not configured".
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Optional: which en-GB Chirp 3 HD voices to test (comma-separated)
VOICE_LAB_GOOGLE_VOICES=Iapetus,Algieba
