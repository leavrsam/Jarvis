{
  "functions": {
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/voice-lab.js": {
      "maxDuration": 60
    },
    "api/jarvis-command.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/camera.js": {
      "maxDuration": 30
    },
    "api/stt-token.js": {
      "maxDuration": 10
    },
    "api/image-search.js": {
      "maxDuration": 20
    },
    "api/calendar.js": {
      "maxDuration": 20
    },
    "api/push.js": {
      "maxDuration": 20
    },
    "api/feed.js": {
      "maxDuration": 20
    },
    "api/news.js": {
      "maxDuration": 20
    },
    "api/markets.js": {
      "maxDuration": 15
    },
    "api/sports.js": {
      "maxDuration": 15
    },
    "api/commute.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/push"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
