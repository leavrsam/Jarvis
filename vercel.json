{
  "functions": {
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/voice-lab.js": {
      "maxDuration": 60
    },
    "api/jarvis-command.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 30
    },
    "api/camera.js": {
      "maxDuration": 30
    },
    "api/stt-token.js": {
      "maxDuration": 10
    },
    "api/image-search.js": {
      "maxDuration": 20
    },
    "api/calendar.js": {
      "maxDuration": 20
    },
    "api/push.js": {
      "maxDuration": 20
    },
    "api/widgets.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/push"
    },
    {
      "source": "/api/feed",
      "destination": "/api/widgets?route=feed"
    },
    {
      "source": "/api/news",
      "destination": "/api/widgets?route=news"
    },
    {
      "source": "/api/markets",
      "destination": "/api/widgets?route=markets"
    },
    {
      "source": "/api/sports",
      "destination": "/api/widgets?route=sports"
    },
    {
      "source": "/api/commute",
      "destination": "/api/widgets?route=commute"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
